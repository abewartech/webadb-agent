# Copy to .env and fill in. NEVER commit the real .env.
WEBADB_TOKEN=change-me-to-a-long-random-secret

# Where the adb server runs. Default reaches the host's adb server
# from inside the container (needs `adb start-server` on the host).
ADB_HOST=host.docker.internal
ADB_PORT=5037

# Optional: pin to one device serial. Empty = first available device.
WEBADB_SERIAL=
